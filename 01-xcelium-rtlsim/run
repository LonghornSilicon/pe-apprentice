#!/usr/bin/env bash
# ============================================================================
# 01-xcelium-rtlsim/run — simulate your RTL against the smoke test.
# ----------------------------------------------------------------------------
# Week 3. Run it from anywhere: ./01-xcelium-rtlsim/run
#
# Outputs land in $PE_WORK/01-xcelium-rtlsim/<run-id>/ (NOT in the repo), with
# a `latest` symlink and a STATUS file. Waveforms: ./run --waves
# ============================================================================
set -euo pipefail

HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../tools/lib/pe-env.sh
source "$HERE/../tools/lib/pe-env.sh"

WAVES=0
[[ "${1:-}" == "--waves" ]] && WAVES=1

pe_require_tool "$XCELIUM_MODULE" xrun || exit 1

RUN="$(pe_rundir 01-xcelium-rtlsim)" || exit 1
echo "Xcelium ($XCELIUM_MODULE)"
echo "  run dir: $RUN"
echo ""
cd "$RUN"

# -access +rwc gives read/write/connect access to every signal in the design.
# Without it the waveform database is empty and SimVision shows you nothing —
# the simulator optimizes away anything no one is reading. It costs runtime,
# which is why production regressions leave it off and debug runs turn it on.
rc=0
xrun -sv -access +rwc \
     "$HERE/../rtl/fxp.sv" \
     "$HERE/../rtl/pe.sv" \
     "$HERE/pe_smoke_tb.sv" \
     -l xrun.log || rc=$?

pe_finish "$RUN" "$rc"

if [[ "$WAVES" == "1" ]]; then
    pe_require_tool "$XCELIUM_MODULE" simvision || exit 1
    echo ""
    echo "Opening waveforms. Compare what you see against your week-2 diagrams."
    echo "If they disagree, one of the two is wrong — work out which before"
    echo "changing any code."
    simvision waves.shm &
fi

echo ""
if [[ "$rc" == "0" ]]; then
    echo "PASS — $RUN/STATUS"
else
    echo "FAIL (rc=$rc) — read $RUN/xrun.log, then $RUN/STATUS"
fi
exit "$rc"
